# Public Supabase project settings (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server-only. Copy the transaction pooler URI from Supabase Connect; URL-encode its password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres
# Server-only; used exclusively for private storage after authorization.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Exact Supabase Auth UUID of the intended owner, set after signup.
FOUNDIT_OWNER_ID=
# Local PostgreSQL without TLS only. Never set to disable on Vercel/Supabase.
# DATABASE_SSL=disable
